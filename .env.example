# AI Configuration
AI_PROVIDER=openai
AI_API_KEY=sk-your-key-here
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-5.4

# Video understanding (Qwen OpenAI-compatible API)
VIDEO_AI_PROVIDER=openai-compatible
VIDEO_AI_API_KEY=sk-your-dashscope-key
VIDEO_AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_AI_MODEL=qwen3.7-plus
VIDEO_AI_FPS=3

# Public frontend/API origin
PUBLIC_BASE_URL=https://inspoclip.example.com

# Public origin that the cloud model can use to fetch /api/model-videos/:id/content
# Leave MODEL_VIDEO_VERIFY_BASE_URL empty unless you intentionally need a separate preflight endpoint.
MODEL_VIDEO_PUBLIC_BASE_URL=https://inspoclip.example.com
MODEL_VIDEO_VERIFY_BASE_URL=

# Unsaved extension video drafts are kept temporarily so users can reopen the in-page analysis panel.
VIDEO_DRAFT_TTL_MS=86400000
VIDEO_DRAFT_CLEANUP_INTERVAL_MS=3600000

# Deployment port
PORT=8080
