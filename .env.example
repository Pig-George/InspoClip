# AI Configuration
AI_PROVIDER=openai
AI_API_KEY=sk-your-key-here
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-5.4

# Video understanding (Qwen OpenAI-compatible API)
VIDEO_AI_PROVIDER=openai-compatible
VIDEO_AI_API_KEY=sk-your-dashscope-key
VIDEO_AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_AI_MODEL=qwen3.7-plus
VIDEO_AI_FPS=3

# Public origin that the cloud model can use to fetch /api/videos/:id/content
PUBLIC_BASE_URL=https://inspoclip.example.com

# Deployment port
PORT=8080
