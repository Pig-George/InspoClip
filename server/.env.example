# Alibaba Cloud Model Studio (or another supported OpenAI-compatible platform)
AI_PROVIDER=alibaba-bailian
AI_API_KEY=your-model-studio-api-key-here
AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.7-plus

# Video understanding can use an independent provider and key.
VIDEO_AI_PROVIDER=alibaba-bailian
VIDEO_AI_API_KEY=your-video-model-api-key-here
VIDEO_AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_AI_MODEL=qwen3.7-plus
VIDEO_AI_FPS=3

# PostgreSQL
DATABASE_URL=postgresql://inspoclip:inspoclip@postgres:5432/inspoclip

# Server
PORT=3001
UPLOAD_DIR=./uploads
VIDEO_UPLOAD_DIR=./videos
VIDEO_DRAFT_TTL_MS=86400000
VIDEO_DRAFT_CLEANUP_INTERVAL_MS=3600000
