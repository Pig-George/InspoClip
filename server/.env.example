# DeepSeek API (or any OpenAI-compatible API)
AI_API_KEY=your-deepseek-api-key-here
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# PostgreSQL
DATABASE_URL=postgresql://inspoclip:inspoclip@postgres:5432/inspoclip

# Server
PORT=3001
UPLOAD_DIR=./uploads
VIDEO_UPLOAD_DIR=./videos
VIDEO_DRAFT_TTL_MS=86400000
VIDEO_DRAFT_CLEANUP_INTERVAL_MS=3600000
